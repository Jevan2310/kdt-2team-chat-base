# 복사해서 .env 로 만들고 값을 채운다. (.env 는 GitHub에 올리지 않음)
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=chat_app
DB_PASSWORD=여기에_DB_비밀번호
DB_NAME=team_chat

# 아무 긴 문자열. 팀원끼리 같을 필요 없음
JWT_SECRET=여기에_긴_임의의_문자열

# (선택) 올린 파일 저장 폴더. 비워 두면 server/uploads
# UPLOADS_DIR=
# (선택) 드라이브 파일 저장 폴더와 파일 하나 최대 크기(MB). 비워 두면 server/storage/files, 50
# STORAGE_DIR=
# MAX_FILE_MB=50
